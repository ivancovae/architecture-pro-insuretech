                <mxCell id="3mdMnyVud1BZKK4QL9wj-23" value="&lt;div style=&quot;line-height: 19px; white-space: pre;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;ul style=&quot;&quot;&gt;&lt;li style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Circuit Breaker - изоляция сбойных API страховых компаний.&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Retry - экспоненциальная отсрочка для временных сбоев.&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Timeout - обеспечение SLA.&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Rate Limit - ограничение входящих синхронных вызовов от core-app&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Helvetica;fontSize=18;fontColor=#000000;" parent="1" vertex="1">
